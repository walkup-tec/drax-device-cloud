# syntax=docker/dockerfile:1.7

FROM node:20.18.1-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=https://api-devices.draxsistemas.com.br
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm install --no-fund --no-audit
RUN mkdir -p apps/web/public
RUN npm run build -w @ddc/web \
  && echo "=== standalone tree ===" \
  && find apps/web/.next/standalone -name server.js -print \
  && ls -la apps/web/.next/standalone \
  && ls -la apps/web/.next/standalone/apps/web 2>/dev/null || ls -la apps/web/.next/standalone

FROM node:20.18.1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4051
ENV HOSTNAME=0.0.0.0
RUN addgroup -S ddc && adduser -S ddc -G ddc
COPY --from=build /app/apps/web/.next/standalone ./
# layout monorepo (outputFileTracingRoot)
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
# layout single-app (fallback se server.js estiver na raiz)
COPY --from=build /app/apps/web/.next/static ./.next/static
COPY --from=build /app/apps/web/public ./public
USER ddc
EXPOSE 4051
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4051/',r=>process.exit(r.statusCode&&r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["sh", "-c", "if [ -f apps/web/server.js ]; then cd apps/web && exec node server.js; elif [ -f server.js ]; then exec node server.js; else echo 'server.js not found' >&2; find /app -name server.js -print; ls -laR /app | head -80; exit 1; fi"]
