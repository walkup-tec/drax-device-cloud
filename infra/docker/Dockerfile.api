# syntax=docker/dockerfile:1.7

FROM node:20.18.1-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN rm -rf apps/web
RUN npm install --no-fund --no-audit
RUN npm run build

FROM node:20.18.1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV API_PORT=4050
# adb + docker CLI para Redroid real (requer /var/run/docker.sock e /dev/kvm no host)
RUN apk add --no-cache android-tools docker-cli curl
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages ./packages
# root necessário para falar com docker.sock no MVP
USER root
EXPOSE 4050
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4050/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
