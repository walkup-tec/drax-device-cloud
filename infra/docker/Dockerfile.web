# syntax=docker/dockerfile:1.7

FROM node:20.18.1-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=https://api-devices.draxsistemas.com.br
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm install --no-fund --no-audit
RUN mkdir -p apps/web/public
RUN npm run build -w @ddc/web

FROM node:20.18.1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4051
ENV HOSTNAME=0.0.0.0
RUN addgroup -S ddc && adduser -S ddc -G ddc
# next build em apps/web gera standalone com server.js na raiz do output
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./.next/static
COPY --from=build /app/apps/web/public ./public
USER ddc
EXPOSE 4051
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4051/',r=>process.exit(r.statusCode&&r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["sh", "-c", "if [ -f server.js ]; then exec node server.js; elif [ -f apps/web/server.js ]; then exec node apps/web/server.js; else echo 'server.js not found' >&2; find /app -name server.js -print; exit 1; fi"]
